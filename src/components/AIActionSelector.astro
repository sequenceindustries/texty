---
import { REWRITE_ACTIONS } from '../../shared/ai';
/** Choose how the AI should rewrite. Plain radio inputs, so it works with keyboard and screen readers. */
interface Props {
  name?: string;
}
const { name = 'action' } = Astro.props;
---

<fieldset class="actions-pick">
  <legend class="legend">How should it be rewritten?</legend>
  <div class="grid">
    {
      REWRITE_ACTIONS.map((a, i) => (
        <label class="opt">
          <input type="radio" name={name} value={a.id} checked={i === 0} />
          <span class="box">
            <span class="name">{a.label}</span>
            <span class="hint">{a.hint}</span>
          </span>
        </label>
      ))
    }
  </div>
</fieldset>

<style>
  .actions-pick {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .legend {
    margin-bottom: var(--s-2);
    padding: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-2);
  }
  .opt {
    position: relative;
    display: block;
  }
  .opt input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .box {
    display: grid;
    gap: 2px;
    height: 100%;
    padding: var(--s-3);
    border-radius: var(--r-ctl);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .name {
    font-weight: 700;
  }
  .hint {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .opt input:checked + .box {
    background: var(--act-wash);
    box-shadow: inset 0 0 0 2px var(--act);
  }
  .opt input:checked + .box .name::after {
    content: ' ✓';
    color: var(--act);
  }
  .opt input:focus-visible + .box {
    outline: 3px solid var(--act);
    outline-offset: 2px;
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
