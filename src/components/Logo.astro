---
/** Wordmark: "texty" with a text caret. The caret blinks once on load, then rests (reduced motion: static). */
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<span class="logo" style={`--s:${size}px`} aria-hidden="true">texty<span class="caret"></span></span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    font: 850 var(--s) / 1 var(--font);
    font-variation-settings: 'CASL' 1;
    letter-spacing: -0.04em;
  }
  .caret {
    display: inline-block;
    width: 0.12em;
    height: 1em;
    margin-left: 0.08em;
    border-radius: 2px;
    background: var(--act);
    animation: blink 1.1s steps(1) 3;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
