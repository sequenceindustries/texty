---
/**
 * Reserved advertising placement. Renders nothing until ads are switched on
 * (PUBLIC_ADS_ENABLED=true). Slots sit outside the tool area only, so an ad
 * can never cover the editor, controls or results.
 */
interface Props {
  name: string;
}
const { name } = Astro.props;
const enabled = import.meta.env.PUBLIC_ADS_ENABLED === 'true';
---

{
  enabled && (
    <aside class="ad-slot wrap" data-ad-slot={name} aria-label="Advertisement">
      <span class="ad-label">Advertisement</span>
      <div class="ad-body" />
    </aside>
  )
}

<style>
  .ad-slot {
    margin-block: var(--s-7);
  }
  .ad-label {
    display: block;
    margin-bottom: var(--s-1);
    font-size: 0.75rem;
    color: var(--ink-faint);
  }
  .ad-body {
    min-height: 100px;
    border-radius: var(--r-paper);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
</style>
