---
import TextEditor from '../TextEditor.astro';
import ResultPanel from '../ResultPanel.astro';
---

<TextEditor id="fr-text" label="Your text" rows={9} />
<div class="panel" data-fr>
  <div class="fields">
    <label class="field">
      <span>Find</span>
      <input class="input" name="find" type="text" autocomplete="off" spellcheck="false" maxlength="1000" aria-describedby="fr-status" />
    </label>
    <label class="field">
      <span>Replace with</span>
      <input class="input" name="replace" type="text" autocomplete="off" spellcheck="false" maxlength="5000" placeholder="Leave empty to delete matches" />
    </label>
  </div>
  <div class="checks">
    <label class="check"><input type="checkbox" name="caseSensitive" /> Match case</label>
    <label class="check"><input type="checkbox" name="wholeWord" /> Whole words only</label>
    <label class="check"><input type="checkbox" name="regex" /> Regular expression</label>
  </div>
  <p class="regex-help" data-regex-help hidden>
    You are entering a <strong>regular expression</strong>, a search pattern. For example <code>\d+</code> finds numbers. In the replacement,
    use <code>$1</code> for the first group in brackets and <code>\n</code> for a new line.
  </p>
  <div class="go">
    <button type="button" class="btn btn--primary" data-act="replace-all" disabled>Replace all</button>
    <button type="button" class="btn" data-act="replace-first" disabled>Replace first</button>
    <p id="fr-status" class="status" data-status role="status" aria-live="polite"></p>
  </div>
</div>
<ResultPanel id="fr-result" label="Result" filename="texty-replaced.txt" rows={9} />

<script>
  import '../../scripts/tools/find-replace';
</script>

<style>
  .panel {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-paper);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .fields {
    display: grid;
    gap: var(--s-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .fields input {
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }
  .checks {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-5);
  }
  .regex-help {
    font-size: var(--step--1);
    color: var(--ink-soft);
    padding: var(--s-2) var(--s-3);
    border-left: 3px solid var(--act);
    background: var(--act-wash);
    border-radius: 0 var(--r-ctl) var(--r-ctl) 0;
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0 3px;
    border-radius: 4px;
    background: var(--surface);
  }
  .go {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
  }
  .status {
    font-weight: 650;
    font-size: var(--step--1);
  }
  .status:global(.is-error) {
    color: var(--del);
  }
</style>
