---
import CopyButton from './CopyButton.astro';
import DownloadButton from './DownloadButton.astro';

/**
 * Output area with copy and download. By default it holds a read-only text area;
 * pass custom content in the default slot (e.g. the diff view) with textarea={false}.
 * Behaviour: src/scripts/result.ts.
 */
interface Props {
  id: string;
  label?: string;
  filename?: string;
  rows?: number;
  copyLabel?: string;
  download?: boolean;
  textarea?: boolean;
  mono?: boolean;
}
const { id, label = 'Result', filename = 'texty.txt', rows = 10, copyLabel = 'Copy result', download = true, textarea = true, mono = false } = Astro.props;
const outId = `${id}-output`;
---

<section class="result is-empty" data-result={id} data-filename={filename} aria-labelledby={`${id}-label`}>
  <div class="head">
    <div class="title">
      {textarea ? <label id={`${id}-label`} for={outId} class="label">{label}</label> : <h2 id={`${id}-label`} class="label">{label}</h2>}
      <p class="meta" data-result-meta role="status" aria-live="polite"></p>
    </div>
    <div class="actions">
      <slot name="actions" />
      <CopyButton label={copyLabel} primary />
      {download && <DownloadButton />}
    </div>
  </div>
  {textarea && <textarea id={outId} class:list={['out', mono && 'mono']} rows={rows} readonly spellcheck="false" placeholder="Your result will appear here."></textarea>}
  <slot />
  <p class="note" data-result-note hidden></p>
</section>

<style>
  .result {
    display: grid;
    gap: var(--s-3);
    min-width: 0;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .title {
    display: grid;
    gap: 2px;
  }
  .label {
    font: 700 var(--step--1) / 1.3 var(--font);
    font-variation-settings: 'CASL' 0;
    letter-spacing: 0;
    color: var(--ink-soft);
  }
  .meta {
    font-size: var(--step--1);
    font-weight: 600;
    min-height: 1.4em;
  }
  .meta :global(strong) {
    font-weight: 800;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .out {
    display: block;
    width: 100%;
    min-height: 8rem;
    padding: var(--s-4) var(--s-5);
    border: 0;
    border-radius: var(--r-paper);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink);
    font: 450 1.0625rem / 1.65 var(--font);
    resize: vertical;
    overflow-wrap: anywhere;
  }
  .out.mono {
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }
  .out:focus-visible {
    outline-offset: 0;
  }
  .note {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  @media (max-width: 560px) {
    .actions {
      width: 100%;
    }
    .actions :global(.btn--primary) {
      flex: 1;
    }
  }
</style>
