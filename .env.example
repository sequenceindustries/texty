# Public origin, used for canonical URLs, sitemap and Open Graph tags (build time). Required in production.
SITE_URL=https://texty.example.com

# Optional: Plausible analytics domain (build time). Also add https://plausible.io to CSP_SCRIPT_SRC and CSP_CONNECT_SRC.
PUBLIC_PLAUSIBLE_DOMAIN=

# Ads stay off until an ad network is configured (build time).
PUBLIC_ADS_ENABLED=false

# Runtime
PORT=8080
LOG_LEVEL=info

# Extra CSP sources (space or comma separated), e.g. for an ad network later.
CSP_SCRIPT_SRC=
CSP_CONNECT_SRC=
CSP_IMG_SRC=
CSP_FRAME_SRC=

# ---------- AI ----------
# Which provider backs the AI tools. Only "anthropic" is implemented today;
# with no key set, the AI tools show "temporarily unavailable".
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Price per million tokens, used only for the cost estimate in usage logs.
AI_PRICE_INPUT_PER_MTOK_USD=1
AI_PRICE_OUTPUT_PER_MTOK_USD=5

# Cost and abuse controls
AI_RATE_LIMIT_PER_MINUTE=6     # burst limit per visitor
AI_DAILY_PER_IP=40             # rewrites per visitor per day
AI_DAILY_GLOBAL=5000           # hard daily cap across all visitors
AI_MAX_CONCURRENT=8            # provider calls in flight
AI_MAX_QUEUE=32
AI_TIMEOUT_SECONDS=30
